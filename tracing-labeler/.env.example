# Copy to .env and fill in values. Restart Expo after changes.
#
# API host only — path /tracing/trainingdata is appended in code.
#
# Physical device (Expo Go): use your computer's LAN IP, not localhost.
# EXPO_PUBLIC_TRACING_API_BASE_URL=http://192.168.1.42:8081
#
# iOS Simulator / Android emulator on the same machine as the API:
EXPO_PUBLIC_TRACING_API_BASE_URL=http://localhost:8081

EXPO_PUBLIC_TRACING_API_KEY=
