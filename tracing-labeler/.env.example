# Copy to .env or .env.local and fill in values. Restart Expo after changes.
#
# Physical device (Expo Go): use your computer's LAN IP, not localhost.
# EXPO_PUBLIC_TRACING_ATTEMPTS_URL=http://192.168.1.42:8001/tracing/trainingdata
#
# iOS Simulator / Android emulator on the same machine as the API:
EXPO_PUBLIC_TRACING_ATTEMPTS_URL=http://localhost:8001/tracing/trainingdata

# Optional: Authorization: Bearer <value>
# EXPO_PUBLIC_TRACING_API_KEY=
